#!/usr/bin/env bash
# Drives the built sweep binary against a fresh Fixture and keeps evidence.
#
#   sweep-verify launch                       build binaries and a Fixture; prints RUN=<dir>
#   sweep-verify doctor  <run>                is this run worth driving?
#   sweep-verify run     <run> <step> [-C <dir>] -- <sweep args...>
#                                             run sweep, record argv, stdout, stderr,
#                                             exit status and what changed in the Fixture
#   sweep-verify du      <run> <path>         bytes du -s gives, as the tests measure it
#   sweep-verify cleanup <run>                remove binaries, Fixture and scratch; keep evidence
#
# Run launch from the checkout under test. Runs live under
# ${SWEEP_VERIFY_DIR:-${TMPDIR:-/tmp}/sweep-verify}/<run-id>/.

set -euo pipefail

marker=.sweep-verify-run

die() {
	printf 'sweep-verify: %s\n' "$*" >&2
	exit 2
}

base() { printf '%s\n' "${SWEEP_VERIFY_DIR:-${TMPDIR:-/tmp}/sweep-verify}"; }

need_run() {
	[ -n "${1:-}" ] || die "give the run directory that launch printed"
	[ -f "$1/$marker" ] || die "$1 is not a run that launch made"
}

exe() { printf '%s/bin/%s%s\n' "$1" "$2" "$(cat "$1/goexe")"; }

listing() {
	(cd "$1" && {
		find . -exec ls -ldn {} +
		find . -type f -exec cksum {} +
	} | LC_ALL=C sort)
}

# Print "blob path" for one untracked path. hash-object follows a symlink and
# fails when the target is missing, so a symlink is hashed as its target text.
hash_untracked() {
	local root=$1 rel=$2 blob
	if [ -L "$root/$rel" ]; then
		blob=$(readlink "$root/$rel" | git hash-object --stdin) || return 1
	else
		blob=$(git -C "$root" --no-optional-locks hash-object -- "$rel") || return 1
	fi
	printf '%s %s\n' "$blob" "$rel"
}

# True when dir is the top of its own repository. A folder inside a repository
# walks up to that repository, so its top and its parent's top are the same.
own_repo() {
	local dir=$1 top parent
	top=$(git -C "$dir" rev-parse --show-toplevel 2> /dev/null) || return 1
	parent=$(git -C "$dir/.." rev-parse --show-toplevel 2> /dev/null || true)
	[ "$top" != "$parent" ]
}

# Hash the files of an untracked nested repository. Its .git directory and the
# paths it ignores are left out, so a fetch, a status or a build output there
# does not change the checksum. An uninitialised submodule is not its own
# repository; record its path instead of failing.
hash_untracked_dir() {
	local root=$1 dir=$2 names rel
	own_repo "$root/$dir" || return 1
	names=$(mktemp)
	git -C "$root/$dir" --no-optional-locks ls-files --cached --others --exclude-standard -z > "$names" || {
		rm -f "$names"
		return 1
	}
	while IFS= read -r -d '' rel; do
		rel=${rel%/}
		if [ -d "$root/$dir/$rel" ] && [ ! -L "$root/$dir/$rel" ]; then
			if own_repo "$root/$dir/$rel"; then
				hash_untracked_dir "$root" "$dir/$rel" || {
					rm -f "$names"
					return 1
				}
			else
				printf 'gitlink %s\n' "$dir/$rel"
			fi
		elif [ ! -e "$root/$dir/$rel" ] && [ ! -L "$root/$dir/$rel" ]; then
			printf 'missing %s\n' "$dir/$rel"
		else
			hash_untracked "$root" "$dir/$rel" || {
				rm -f "$names"
				return 1
			}
		fi
	done < "$names"
	rm -f "$names"
}

checkout_state() {
	local root=$1
	# git diff HEAD omits untracked files, so an edit to one would leave this
	# checksum unchanged and the doctor would accept a stale binary.
	(
		list=$(mktemp)
		out=$(mktemp)
		# An EXIT trap that only removes the files would report success after a failed hash.
		trap 'status=$?; rm -f "$list" "$out"; exit "$status"' EXIT
		git -C "$root" --no-optional-locks ls-files --others --exclude-standard -z > "$list"
		{
			git -C "$root" rev-parse HEAD
			git -C "$root" --no-optional-locks status --porcelain=v1 --untracked-files=all
			git -C "$root" --no-optional-locks diff HEAD
			while IFS= read -r -d '' path; do
				path=${path%/}
				if [ -d "$root/$path" ] && [ ! -L "$root/$path" ]; then
					# An untracked nested repository is one directory entry, and
					# hash-object cannot hash the directory.
					hash_untracked_dir "$root" "$path" || exit 1
				else
					hash_untracked "$root" "$path" || exit 1
				fi
			done < "$list"
		} > "$out"
		cksum < "$out"
	)
}

# Problems with the Trap, or nothing when it holds. The repository also
# holds an ignored Candidate and an untracked one, so a status of the whole
# work tree is not the Trap. Ask only about its node_modules, and require
# git to track something there.
trap_tracked() {
	local repo="$1/fixture/projects/tracked-app" tracked
	git -C "$repo" --no-optional-locks status --porcelain -- node_modules
	tracked=$(git -C "$repo" --no-optional-locks ls-files -- node_modules)
	[ -n "$tracked" ] || printf 'node_modules is not tracked\n'
}

cmd_launch() {
	command -v go > /dev/null || die "go is not on the PATH"
	local checkout run
	checkout=$(git rev-parse --show-toplevel 2> /dev/null) || die "run launch from inside the sweep checkout to verify"
	[ -f "$checkout/cmd/sweep/main.go" ] && [ -f "$checkout/tools/fixture/main.go" ] || die "$checkout is not a sweep checkout"
	run="$(base)/$(date -u +%Y%m%dT%H%M%SZ)-$$"
	mkdir -p "$run/bin" "$run/evidence" "$run/scratch"
	: > "$run/$marker"
	printf '%s\n' "$checkout" > "$run/checkout"
	(cd "$checkout" && go env GOEXE) > "$run/goexe"
	(cd "$checkout" && go build -o "$(exe "$run" sweep)" ./cmd/sweep && go build -o "$(exe "$run" fixture)" ./tools/fixture)
	"$(exe "$run" fixture)" "$run/fixture"
	# The home directory a run uses is under scratch, not inside the
	# Fixture. On macOS the default Plan is under HOME, and a dry run must
	# not write that into the Fixture. The copy keeps the npm cache findable.
	mkdir -p "$run/scratch/home"
	if [ -d "$run/fixture/home" ]; then
		cp -a "$run/fixture/home/." "$run/scratch/home/"
	fi
	checkout_state "$checkout" > "$run/checkout-state"
	listing "$run/fixture" > "$run/evidence/fixture-listing-built.txt"
	cp "$run/fixture/answer-key.json" "$run/evidence/answer-key.json"
	{
		printf 'checkout: %s\n' "$(git -C "$checkout" rev-parse HEAD)"
		printf 'checkout changes:\n'
		git -C "$checkout" --no-optional-locks status --short
		printf 'sweep --version: %s\n' "$("$(exe "$run" sweep)" --version)"
		go version -m "$(exe "$run" sweep)" | grep -E 'vcs\.' || true
	} > "$run/evidence/build.txt"
	printf 'ready: sweep and the Fixture are built\nRUN=%s\n' "$run"
}

cmd_doctor() {
	need_run "${1:-}"
	local run=$1 fail=0 checkout
	checkout=$(cat "$run/checkout")
	check() {
		if eval "$2"; then printf 'ok    %s\n' "$1"; else
			printf 'FAIL  %s\n' "$1"
			fail=1
		fi
	}
	check "du and git are on the PATH" 'command -v du > /dev/null && command -v git > /dev/null'
	check "sweep is built and prints its version" '"$(exe "$run" sweep)" --version | grep -q "^sweep "'
	check "the checkout has not changed since launch (else launch again)" '[ "$(checkout_state "$checkout")" = "$(cat "$run/checkout-state")" ]'
	check "the Fixture is as the fixture tool built it" 'listing "$run/fixture" | cmp -s - "$run/evidence/fixture-listing-built.txt"'
	check "git tracks every file of the Trap in projects/tracked-app" '[ -z "$(trap_tracked "$run")" ]'
	if [ "$fail" != 0 ]; then
		printf 'doctor: do not drive this run\n'
		return 1
	fi
	printf 'doctor: worth driving\n'
}

cmd_run() {
	need_run "${1:-}"
	local run=$1 step=${2:-} dir
	[ -n "$step" ] || die "give a step name, such as scan-json/match"
	shift 2
	dir="$run/fixture"
	if [ "${1:-}" = -C ]; then
		case "$2" in
		/*) dir=$2 ;;
		*) dir="$run/fixture/$2" ;;
		esac
		shift 2
	fi
	[ "${1:-}" = -- ] || die "put -- before the sweep arguments"
	shift
	local out="$run/evidence/$step" status
	mkdir -p "$out"
	{
		printf 'cwd: %s\n' "$dir"
		printf 'argv: sweep'
		# A missing printf argument is treated as empty, which would record
		# `argv: sweep ''` when sweep was run with no arguments.
		if [ "$#" -gt 0 ]; then
			printf ' %q' "$@"
		fi
		printf '\n'
	} > "$out/command.txt"
	listing "$run/fixture" > "$out/fixture-before.txt"
	touch "$out/.started"
	set +e
	# Default the home to the scratch copy, so a Scan finds the npm cache
	# and a dry run's Plan stays out of the Fixture. A caller that already
	# pointed HOME or USERPROFILE inside this run keeps it. That is how a
	# macOS Clean puts the trash under the Fixture instead of the scratch copy.
	home="$run/scratch/home"
	case ${HOME:-} in
	"$run"/*) home=$HOME ;;
	esac
	profile="$run/scratch/home"
	case ${USERPROFILE:-} in
	"$run"/*) profile=$USERPROFILE ;;
	esac
	(cd "$dir" && HOME="$home" USERPROFILE="$profile" "$(exe "$run" sweep)" "$@") > "$out/stdout" 2> "$out/stderr"
	status=$?
	set -e
	printf '%s\n' "$status" > "$out/status"
	listing "$run/fixture" > "$out/fixture-after.txt"
	{
		diff "$out/fixture-before.txt" "$out/fixture-after.txt" || true
		(cd "$run/fixture" && find . -newer "$out/.started" | sed 's/^/newer than the start: /')
	} > "$out/fixture-changes.txt"
	rm "$out/.started" "$out/fixture-before.txt" "$out/fixture-after.txt"
	printf -- '--- %s: exit status %s\n--- stdout\n%s\n--- stderr\n%s\n' "$step" "$status" "$(cat "$out/stdout")" "$(cat "$out/stderr")"
	if [ -s "$out/fixture-changes.txt" ]; then
		printf -- '--- the Fixture CHANGED:\n%s\n' "$(cat "$out/fixture-changes.txt")"
	else
		printf -- '--- the Fixture is unchanged\n'
	fi
	printf -- '--- evidence: %s\n' "$out"
}

cmd_du() {
	need_run "${1:-}"
	[ -e "${2:-}" ] || die "give a path that exists"
	local blocks
	blocks=$(env -u DU_BLOCK_SIZE -u BLOCK_SIZE POSIXLY_CORRECT=1 BLOCKSIZE=512 du -s "$2" | awk '{print $1}')
	printf '%s %s\n' "$((blocks * 512))" "$2" | tee -a "$1/evidence/du.txt"
}

cmd_cleanup() {
	need_run "${1:-}"
	local run=$1
	chmod -R u+rwx "$run/scratch" "$run/fixture" 2> /dev/null || true
	rm -rf "$run/bin" "$run/fixture" "$run/scratch"
	printf 'cleaned: binaries, Fixture and scratch are gone\nevidence kept: %s/evidence\n' "$run"
}

case "${1:-}" in
launch) cmd_launch ;;
doctor) cmd_doctor "${2:-}" ;;
run) shift && cmd_run "$@" ;;
du) cmd_du "${2:-}" "${3:-}" ;;
cleanup) cmd_cleanup "${2:-}" ;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' && exit 2 ;;
esac
